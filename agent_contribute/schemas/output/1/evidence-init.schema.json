{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:1:evidence-init",
  "title": "evidence init result",
  "description": "Result of writing an unfilled evidence skeleton; nothing was executed.",
  "type": "object",
  "properties": {
    "output": {
      "type": "string",
      "description": "Path of the new evidence file",
      "maxLength": 100000
    },
    "evidence_valid": {
      "type": "boolean",
      "const": false,
      "description": "A skeleton never validates"
    },
    "schema_errors": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of evidence schema errors left to fill"
    },
    "warning": {
      "type": "string",
      "maxLength": 100000
    }
  },
  "required": [
    "output",
    "evidence_valid",
    "schema_errors",
    "warning"
  ],
  "additionalProperties": false
}
