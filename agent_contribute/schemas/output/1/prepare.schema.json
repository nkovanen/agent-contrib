{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:1:prepare",
  "title": "prepare result",
  "description": "Draft contract written to --output, or the unresolved inspect result when no draft was written.",
  "anyOf": [
    {
      "$ref": "#/$defs/prepared"
    },
    {
      "$ref": "#/$defs/issue_unresolved"
    }
  ],
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 100000
        },
        "note": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "issue_unresolved": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line",
          "maxLength": 100000
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved",
          "maxLength": 100000
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority",
          "maxLength": 100000
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "reference": {
          "type": "string",
          "description": "owner/repo#number as requested",
          "maxLength": 100000
        },
        "complete": {
          "type": "boolean",
          "const": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "reference",
        "complete",
        "errors"
      ],
      "additionalProperties": false,
      "description": "The repository or issue could not be resolved or read; nothing else is reported"
    },
    "metadata_read": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "maxLength": 100000
        },
        "observed": {
          "$ref": "#/$defs/repository_observation"
        },
        "fetched_at": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "endpoint",
        "observed",
        "fetched_at"
      ],
      "additionalProperties": false
    },
    "prepared": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line",
          "maxLength": 100000
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved",
          "maxLength": 100000
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority",
          "maxLength": 100000
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "reference": {
          "type": "string",
          "maxLength": 100000
        },
        "output": {
          "type": "string",
          "description": "Path of the new draft contract",
          "maxLength": 100000
        },
        "complete": {
          "type": "boolean",
          "description": "Whether the inspect read behind the draft was complete"
        },
        "contract": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "enum": [
                "0.1",
                "0.2"
              ]
            }
          },
          "required": [
            "schema_version"
          ],
          "additionalProperties": true,
          "description": "The draft task contract as written; validate it with the task schema of its schema_version"
        },
        "warning": {
          "type": "string",
          "maxLength": 100000
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "reference",
        "output",
        "complete",
        "contract",
        "warning"
      ],
      "additionalProperties": false,
      "description": "A draft was written; it grants no authorization"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 100000
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    },
    "repository_observation": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "maxLength": 100000
        },
        "fork": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "parent": {
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "full_name"
          ],
          "additionalProperties": false,
          "description": "Immediate fork parent, when it was read"
        }
      },
      "required": [
        "full_name",
        "fork",
        "has_issues"
      ],
      "additionalProperties": false
    },
    "resolution_provenance": {
      "type": "object",
      "properties": {
        "metadata_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_read"
          },
          "maxItems": 1000
        },
        "reason": {
          "type": "string",
          "description": "How the issue tracker was chosen, or \"unresolved\"",
          "maxLength": 100000
        },
        "execution_authority": {
          "type": "string",
          "description": "Always \"none\": resolution never grants authority",
          "maxLength": 100000
        }
      },
      "required": [
        "metadata_reads",
        "reason",
        "execution_authority"
      ],
      "additionalProperties": false
    }
  }
}
