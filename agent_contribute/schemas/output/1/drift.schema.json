{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:1:drift",
  "title": "drift result",
  "description": "Read-only report of what changed since the contract was prepared. issue, source, default_branch, instructions, policy and overlap are present once the current source was read.",
  "type": "object",
  "properties": {
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64,
      "minLength": 64
    },
    "complete": {
      "type": "boolean",
      "description": "False when any read failed; then drifted may be null or partial"
    },
    "drifted": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Null when the current source could not be read"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100000
      },
      "maxItems": 1000
    },
    "notice": {
      "type": "string",
      "maxLength": 100000
    },
    "issue": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "stored_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "minLength": 64
        },
        "current_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "minLength": 64
        },
        "stored_updated_at": {
          "type": "string",
          "maxLength": 100000
        },
        "current_updated_at": {
          "type": "string",
          "maxLength": 100000
        },
        "current_components": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "title_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64,
              "minLength": 64
            },
            "body_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64,
              "minLength": 64
            },
            "state": {
              "type": "string",
              "maxLength": 100000
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100000
              },
              "maxItems": 1000
            },
            "assignees": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100000
              },
              "maxItems": 1000
            }
          },
          "required": [
            "title_sha256",
            "body_sha256",
            "state",
            "labels",
            "assignees"
          ],
          "additionalProperties": false,
          "description": "Per-component hashes of the current issue; null when unreadable"
        },
        "component_baseline": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "changed",
        "stored_sha256",
        "current_sha256",
        "stored_updated_at",
        "current_updated_at",
        "current_components",
        "component_baseline"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "stored_repository": {
          "type": "string",
          "maxLength": 100000
        },
        "current_repository": {
          "type": "string",
          "maxLength": 100000
        },
        "stored_issue_url": {
          "type": "string",
          "maxLength": 100000
        },
        "current_issue_url": {
          "type": "string",
          "maxLength": 100000
        },
        "changed": {
          "type": "boolean"
        },
        "stored_identity": {
          "type": "object",
          "properties": {
            "repository_id": {
              "type": "integer"
            },
            "owner_id": {
              "type": "integer"
            },
            "issue_id": {
              "type": "integer"
            }
          },
          "required": [
            "repository_id",
            "owner_id",
            "issue_id"
          ],
          "additionalProperties": false,
          "description": "Schema 0.2 contracts only"
        },
        "current_identity": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "repository_id": {
              "type": "integer"
            },
            "owner_id": {
              "type": "integer"
            },
            "issue_id": {
              "type": "integer"
            }
          },
          "required": [
            "repository_id",
            "owner_id",
            "issue_id"
          ],
          "additionalProperties": false,
          "description": "Schema 0.2 contracts only; null when unresolved"
        }
      },
      "required": [
        "stored_repository",
        "current_repository",
        "stored_issue_url",
        "current_issue_url",
        "changed"
      ],
      "additionalProperties": false
    },
    "default_branch": {
      "type": "object",
      "properties": {
        "stored_branch": {
          "type": "string",
          "maxLength": 100000
        },
        "current_branch": {
          "type": "string",
          "maxLength": 100000
        },
        "stored_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40,
          "minLength": 40
        },
        "current_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40,
          "minLength": 40
        },
        "advanced": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "stored_branch",
        "current_branch",
        "stored_commit",
        "current_commit",
        "advanced",
        "note"
      ],
      "additionalProperties": false
    },
    "instructions": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "baseline_verified": {
          "type": "boolean"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 100000
              },
              "stored_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "maxLength": 64,
                "minLength": 64
              },
              "current_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "maxLength": 64,
                "minLength": 64
              }
            },
            "required": [
              "path",
              "stored_sha256",
              "current_sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "changed",
        "baseline_verified",
        "added",
        "removed",
        "modified"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "stored_approval": {
          "type": "string",
          "maxLength": 100000
        },
        "current_approval": {
          "type": "string",
          "maxLength": 100000
        },
        "current_policy_state": {
          "type": "string",
          "enum": [
            "missing",
            "present",
            "unknown"
          ]
        },
        "changed": {
          "type": "boolean"
        },
        "stored_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Schema 0.2 contracts only",
          "maxLength": 64,
          "minLength": 64
        },
        "current_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Schema 0.2 contracts only",
          "maxLength": 64,
          "minLength": 64
        }
      },
      "required": [
        "stored_approval",
        "current_approval",
        "current_policy_state",
        "changed"
      ],
      "additionalProperties": false
    },
    "overlap": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "description": "Open PR URLs overlapping now but not at preparation",
          "maxItems": 1000
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        },
        "scope": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "added",
        "removed",
        "scope"
      ],
      "additionalProperties": false
    },
    "api_budget": {
      "$ref": "#/$defs/api_budget"
    }
  },
  "required": [
    "contract_sha256",
    "complete",
    "drifted",
    "errors",
    "notice"
  ],
  "additionalProperties": false,
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 100000
        },
        "note": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 100000
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    }
  }
}
