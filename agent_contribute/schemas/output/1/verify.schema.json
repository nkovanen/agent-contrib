{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:1:verify",
  "title": "verify result",
  "description": "Contract, live GitHub state and optional evidence checks; never runs validation argv. The shape follows the contract schema_version (0.1 or 0.2) and whether the contract validated.",
  "anyOf": [
    {
      "$ref": "#/$defs/verify_0_1"
    },
    {
      "$ref": "#/$defs/verify_0_1_rejected"
    },
    {
      "$ref": "#/$defs/verify_0_2"
    },
    {
      "$ref": "#/$defs/verify_0_2_rejected"
    }
  ],
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 100000
        },
        "note": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "candidate",
            "unknown"
          ]
        },
        "policy_path": {
          "type": "string",
          "maxLength": 100000
        },
        "policy_commit": {
          "type": "string",
          "maxLength": 100000
        },
        "matched_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        },
        "reason": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "status",
        "policy_path",
        "policy_commit",
        "matched_labels",
        "reason"
      ],
      "additionalProperties": false,
      "description": "Source approval from the default-branch .agent-contrib.json policy; never execution authorization"
    },
    "authorization_provenance": {
      "type": "object",
      "properties": {
        "fetched_at": {
          "type": "string",
          "maxLength": 100000
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "description": "GitHub endpoints read",
          "maxItems": 1000
        }
      },
      "required": [
        "fetched_at",
        "endpoints"
      ],
      "additionalProperties": false
    },
    "ci_observation": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Repository whose CI was read: the execution target, else the source",
          "maxLength": 100000
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$",
          "description": "Evidence git_head; null when the evidence has none",
          "maxLength": 40,
          "minLength": 40
        },
        "complete": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        },
        "notice": {
          "type": "string",
          "maxLength": 100000
        },
        "check_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verify_check_run"
          },
          "maxItems": 4000,
          "description": "Check runs for exactly head_sha"
        },
        "other_head_runs": {
          "type": "integer",
          "minimum": 0,
          "description": "Returned runs for a different head; ignored"
        },
        "check_runs_complete": {
          "type": "boolean"
        },
        "combined_status": {
          "type": "object",
          "properties": {
            "state": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "success",
                "failure",
                "pending",
                "error",
                null
              ],
              "description": "Null when the read failed"
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "context": {
                    "type": "string",
                    "maxLength": 100000
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "success",
                      "failure",
                      "pending",
                      "error"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 100000
                  }
                },
                "required": [
                  "context",
                  "state",
                  "url"
                ],
                "additionalProperties": false
              },
              "maxItems": 4000
            },
            "complete": {
              "type": "boolean"
            }
          },
          "required": [
            "state",
            "statuses",
            "complete"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repository",
        "head_sha",
        "complete",
        "errors",
        "notice"
      ],
      "additionalProperties": false,
      "description": "Added by --observe-ci on a schema-valid contract; report only, never changes gates or exit status. The run and status fields are absent when there was no valid head or target to read"
    },
    "duplicate": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string",
          "maxLength": 100000
        },
        "reason": {
          "type": "string",
          "description": "\"Explicit reference to this issue\" or a heuristic overlap naming the shared words/IDs",
          "maxLength": 100000
        },
        "repository": {
          "type": "string",
          "description": "Repository of the PR, when it is not the issue source",
          "maxLength": 100000
        }
      },
      "required": [
        "number",
        "url",
        "reason"
      ],
      "additionalProperties": false,
      "description": "An open PR that references or overlaps the issue"
    },
    "list_scan": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        }
      },
      "required": [
        "complete",
        "pages",
        "errors"
      ],
      "additionalProperties": false,
      "description": "Completeness of one paginated GitHub list read"
    },
    "metadata_read": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "maxLength": 100000
        },
        "observed": {
          "$ref": "#/$defs/repository_observation"
        },
        "fetched_at": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "endpoint",
        "observed",
        "fetched_at"
      ],
      "additionalProperties": false
    },
    "policy_file": {
      "description": "The parsed .agent-contrib.json exactly as read: any JSON value, untrusted and possibly invalid; null when absent"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 100000
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    },
    "repository_observation": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "maxLength": 100000
        },
        "fork": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "parent": {
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "full_name"
          ],
          "additionalProperties": false,
          "description": "Immediate fork parent, when it was read"
        }
      },
      "required": [
        "full_name",
        "fork",
        "has_issues"
      ],
      "additionalProperties": false
    },
    "resolution_provenance": {
      "type": "object",
      "properties": {
        "metadata_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_read"
          },
          "maxItems": 1000
        },
        "reason": {
          "type": "string",
          "description": "How the issue tracker was chosen, or \"unresolved\"",
          "maxLength": 100000
        },
        "execution_authority": {
          "type": "string",
          "description": "Always \"none\": resolution never grants authority",
          "maxLength": 100000
        }
      },
      "required": [
        "metadata_reads",
        "reason",
        "execution_authority"
      ],
      "additionalProperties": false
    },
    "target_pulls_scan": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 100000
        },
        "endpoint": {
          "type": "string",
          "maxLength": 100000
        },
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        }
      },
      "required": [
        "repository",
        "endpoint",
        "complete",
        "pages",
        "errors"
      ],
      "additionalProperties": false,
      "description": "Open-PR scan of the proposed target repository when it differs from the issue source"
    },
    "verify_0_1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "schema_valid": {
          "type": "boolean",
          "description": "The contract matches the bundled task schema"
        },
        "execution_ready": {
          "type": "boolean",
          "description": "Contract, live source and local execution authorization all pass"
        },
        "evidence_valid": {
          "type": "boolean",
          "description": "Supplied evidence validates against the contract and checkout"
        },
        "upstream_submission_ready": {
          "type": "boolean",
          "description": "Exit gate for upstream-contribution mode"
        },
        "fork_completion_ready": {
          "type": "boolean",
          "description": "Exit gate for fork-experiment mode"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "$ref": "#/$defs/verify_unrefreshed_approval"
            }
          ],
          "description": "Live source approval; \"Not refreshed\" until the live read succeeds"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "description": "Blockers for execution_ready",
          "maxItems": 1000
        },
        "evidence_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "description": "Blockers for evidence_valid",
          "maxItems": 1000
        },
        "evidence_trust": {
          "type": "string",
          "description": "Evidence is self-attested; identity and truth are not authenticated",
          "maxLength": 100000
        },
        "publication": {
          "type": "string",
          "description": "Fixed notice: this CLI never publishes",
          "maxLength": 100000
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        },
        "ci_observation": {
          "$ref": "#/$defs/ci_observation"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Canonical hash of the contract",
          "maxLength": 64,
          "minLength": 64
        },
        "requested_repository": {
          "type": "null",
          "description": "Not stored in schema 0.1"
        },
        "issue_source_repository": {
          "type": "string",
          "maxLength": 100000
        },
        "proposed_target_repository": {
          "type": "string",
          "maxLength": 100000
        },
        "resolution_provenance": {
          "type": "object",
          "properties": {
            "requested_repository": {
              "type": "string",
              "maxLength": 100000
            },
            "issue_source_repository": {
              "type": "string",
              "maxLength": 100000
            },
            "proposed_target_repository": {
              "type": "string",
              "maxLength": 100000
            },
            "execution_authority": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "requested_repository",
            "issue_source_repository",
            "proposed_target_repository",
            "execution_authority"
          ],
          "additionalProperties": false,
          "description": "Which contract fields the repositories come from"
        },
        "live_complete": {
          "type": "boolean",
          "description": "Whether the live refresh was complete"
        },
        "live_provenance": {
          "$ref": "#/$defs/verify_live_provenance"
        },
        "source_resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "duplicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duplicate"
          },
          "description": "Open PRs overlapping the issue now",
          "maxItems": 1000
        },
        "execution_authorization": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "pending",
                "fork-experiment",
                "upstream-contribution"
              ]
            },
            "target_repository": {
              "type": "string",
              "maxLength": 100000
            },
            "authorized_by": {
              "type": "string",
              "maxLength": 100000
            },
            "authorization_evidence": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "mode",
            "target_repository",
            "authorized_by",
            "authorization_evidence"
          ],
          "additionalProperties": false,
          "description": "The contract's execution block, echoed; a reviewed assertion, never inferred"
        }
      },
      "required": [
        "schema_version",
        "schema_valid",
        "execution_ready",
        "evidence_valid",
        "upstream_submission_ready",
        "fork_completion_ready",
        "approval",
        "errors",
        "evidence_errors",
        "evidence_trust",
        "publication",
        "contract_sha256",
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "live_complete",
        "execution_authorization"
      ],
      "additionalProperties": false,
      "description": "Schema 0.1: a schema-valid contract was checked. live_provenance, source_resolution_provenance and duplicates are absent when the live refresh failed"
    },
    "verify_0_1_rejected": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "schema_valid": {
          "type": "boolean",
          "description": "The contract matches the bundled task schema"
        },
        "execution_ready": {
          "type": "boolean",
          "description": "Contract, live source and local execution authorization all pass"
        },
        "evidence_valid": {
          "type": "boolean",
          "description": "Supplied evidence validates against the contract and checkout"
        },
        "upstream_submission_ready": {
          "type": "boolean",
          "description": "Exit gate for upstream-contribution mode"
        },
        "fork_completion_ready": {
          "type": "boolean",
          "description": "Exit gate for fork-experiment mode"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "$ref": "#/$defs/verify_unrefreshed_approval"
            }
          ],
          "description": "Live source approval; \"Not refreshed\" until the live read succeeds"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "description": "Blockers for execution_ready",
          "maxItems": 1000
        },
        "evidence_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "description": "Blockers for evidence_valid",
          "maxItems": 1000
        },
        "evidence_trust": {
          "type": "string",
          "description": "Evidence is self-attested; identity and truth are not authenticated",
          "maxLength": 100000
        },
        "publication": {
          "type": "string",
          "description": "Fixed notice: this CLI never publishes",
          "maxLength": 100000
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        },
        "ci_observation": {
          "$ref": "#/$defs/ci_observation"
        }
      },
      "required": [
        "schema_version",
        "schema_valid",
        "execution_ready",
        "evidence_valid",
        "upstream_submission_ready",
        "fork_completion_ready",
        "approval",
        "errors",
        "evidence_errors",
        "evidence_trust",
        "publication"
      ],
      "additionalProperties": false,
      "description": "Schema 0.1: the contract failed validation; nothing was read"
    },
    "verify_0_2": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.2"
        },
        "schema_valid": {
          "type": "boolean",
          "const": true
        },
        "repository_approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "$ref": "#/$defs/verify_unrefreshed_approval"
            }
          ],
          "description": "Live source approval; \"Not refreshed\" when the live read failed"
        },
        "user_authorization": {
          "$ref": "#/$defs/verify_user_authorization"
        },
        "implementation_ready": {
          "type": "boolean",
          "description": "Gate for --stage implementation"
        },
        "technical_evidence_valid": {
          "type": "boolean",
          "description": "Supplied evidence validates against the contract and checkout"
        },
        "independent_review": {
          "$ref": "#/$defs/verify_review"
        },
        "draft_create_ready": {
          "type": "boolean",
          "description": "Draft-creation gate; false once an own draft is verified"
        },
        "publication": {
          "$ref": "#/$defs/verify_publication"
        },
        "human_signoff": {
          "$ref": "#/$defs/verify_signoff"
        },
        "completion_ready": {
          "type": "boolean",
          "description": "Gate for --stage completion (the default)"
        },
        "next_action": {
          "type": "string",
          "enum": [
            "resolve_blockers",
            "implement",
            "create_draft",
            "none"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "description": "Contract, live-source and mandate blockers",
          "maxItems": 1000
        },
        "evidence_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        },
        "stage_blockers": {
          "type": "object",
          "properties": {
            "implementation": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100000
              },
              "maxItems": 1000
            },
            "draft": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100000
              },
              "maxItems": 1000
            },
            "completion": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100000
              },
              "maxItems": 1000
            }
          },
          "required": [
            "implementation",
            "draft",
            "completion"
          ],
          "additionalProperties": false,
          "description": "Blockers per --stage gate"
        },
        "blocking_duplicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duplicate"
          },
          "description": "Overlapping PRs other than the verified own draft",
          "maxItems": 1000
        },
        "evidence_trust": {
          "type": "string",
          "description": "Evidence is self-attested; identity and truth are not authenticated",
          "maxLength": 100000
        },
        "mandate_trust": {
          "type": "string",
          "const": "host-asserted"
        },
        "mandate_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "minLength": 64
        },
        "final_signoff_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "minLength": 64
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "minLength": 64
        },
        "source_identity": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "maxLength": 100000
            },
            "repository_id": {
              "type": "integer",
              "minimum": 1
            },
            "owner_id": {
              "type": "integer",
              "minimum": 1
            },
            "issue": {
              "type": "integer",
              "minimum": 1
            },
            "issue_id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "repository",
            "repository_id",
            "owner_id",
            "issue",
            "issue_id"
          ],
          "additionalProperties": false,
          "description": "Reviewed numeric source identity"
        },
        "live_complete": {
          "type": "boolean"
        },
        "live_provenance": {
          "$ref": "#/$defs/verify_live_provenance"
        },
        "duplicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duplicate"
          },
          "description": "Open PRs overlapping the issue now",
          "maxItems": 1000
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        },
        "ci_observation": {
          "$ref": "#/$defs/ci_observation"
        }
      },
      "required": [
        "schema_version",
        "schema_valid",
        "repository_approval",
        "user_authorization",
        "implementation_ready",
        "technical_evidence_valid",
        "independent_review",
        "draft_create_ready",
        "publication",
        "human_signoff",
        "completion_ready",
        "next_action",
        "errors",
        "evidence_errors",
        "stage_blockers",
        "blocking_duplicates",
        "evidence_trust",
        "mandate_trust",
        "mandate_sha256",
        "final_signoff_sha256",
        "contract_sha256",
        "source_identity",
        "live_complete",
        "duplicates"
      ],
      "additionalProperties": false,
      "description": "Schema 0.2: a schema-valid contract was checked. live_provenance is absent when the live refresh failed"
    },
