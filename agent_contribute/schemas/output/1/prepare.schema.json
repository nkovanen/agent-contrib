{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:1:prepare",
  "title": "prepare result",
  "description": "Draft contract written to --output, or the unresolved inspect result when no draft was written.",
  "anyOf": [
    {
      "$ref": "#/$defs/prepared"
    },
    {
      "$ref": "#/$defs/issue_unresolved"
    }
  ],
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 2147483647
        },
        "note": {
          "type": "string",
          "maxLength": 2147483647
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "issue_unresolved": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line",
          "maxLength": 2147483647
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved",
          "maxLength": 2147483647
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority",
          "maxLength": 2147483647
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "reference": {
          "type": "string",
          "description": "owner/repo#number as requested",
          "maxLength": 2147483647
        },
        "complete": {
          "type": "boolean",
          "const": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2147483647
          },
          "minItems": 1,
          "maxItems": 2147483647
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "reference",
        "complete",
        "errors"
      ],
      "additionalProperties": false,
      "description": "The repository or issue could not be resolved or read; nothing else is reported"
    },
    "metadata_read": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "maxLength": 2147483647
        },
        "observed": {
          "$ref": "#/$defs/repository_observation"
        },
        "fetched_at": {
          "type": "string",
          "maxLength": 2147483647
        }
      },
      "required": [
        "endpoint",
        "observed",
        "fetched_at"
      ],
      "additionalProperties": false
    },
    "prepared": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line",
          "maxLength": 2147483647
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved",
          "maxLength": 2147483647
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority",
          "maxLength": 2147483647
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "reference": {
          "type": "string",
          "maxLength": 2147483647
        },
        "output": {
          "type": "string",
          "description": "Path of the new draft contract",
          "maxLength": 2147483647
        },
        "complete": {
          "type": "boolean",
          "description": "Whether the inspect read behind the draft was complete"
        },
        "contract": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "enum": [
                "0.1",
                "0.2"
              ]
            }
          },
          "required": [
            "schema_version"
          ],
          "additionalProperties": true,
          "description": "The draft task contract as written; validate it with the task schema of its schema_version"
        },
        "warning": {
          "type": "string",
          "maxLength": 2147483647
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        },
        "repository_policy": {
          "$ref": "#/$defs/repository_policy",
          "description": "Default-on, report-only; never a verdict"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "reference",
        "output",
        "complete",
        "contract",
        "warning"
      ],
      "additionalProperties": false,
      "description": "A draft was written; it grants no authorization"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 2147483647
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    },
    "repository_observation": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "maxLength": 2147483647
        },
        "fork": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "parent": {
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "maxLength": 2147483647
            }
          },
          "required": [
            "full_name"
          ],
          "additionalProperties": false,
          "description": "Immediate fork parent, when it was read"
        }
      },
      "required": [
        "full_name",
        "fork",
        "has_issues"
      ],
      "additionalProperties": false
    },
    "resolution_provenance": {
      "type": "object",
      "properties": {
        "metadata_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_read"
          },
          "maxItems": 1000
        },
        "reason": {
          "type": "string",
          "description": "How the issue tracker was chosen, or \"unresolved\"",
          "maxLength": 2147483647
        },
        "execution_authority": {
          "type": "string",
          "description": "Always \"none\": resolution never grants authority",
          "maxLength": 2147483647
        }
      },
      "required": [
        "metadata_reads",
        "reason",
        "execution_authority"
      ],
      "additionalProperties": false
    },
    "repository_policy": {
      "type": "object",
      "properties": {
        "report": {
          "type": "string",
          "enum": [
            "policy-report/1"
          ]
        },
        "review_obligation": {
          "type": "string",
          "maxLength": 2147483647
        },
        "sources_scanned": {
          "type": "array",
          "maxItems": 2147483647,
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "enum": [
                  "repository",
                  "owner-github"
                ]
              },
              "repository": {
                "type": "string",
                "maxLength": 2147483647
              },
              "path": {
                "type": "string",
                "maxLength": 500
              },
              "path_truncated": {
                "type": "boolean"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "minLength": 40,
                "maxLength": 40
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ai_policy",
                  "agent_instructions",
                  "contributing",
                  "pr_template",
                  "community",
                  "readme",
                  "instruction"
                ]
              },
              "notes": {
                "type": "array",
                "maxItems": 2147483647,
                "items": {
                  "type": "string",
                  "maxLength": 2147483647
                }
              }
            },
            "required": [
              "origin",
              "repository",
              "path",
              "path_truncated",
              "commit",
              "sha256",
              "kind",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "unassessed": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "what": {
                "type": "string",
                "maxLength": 500
              },
              "reason": {
                "type": "string",
                "maxLength": 2147483647
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2147483647
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "link_text": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              },
              "what_truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "what",
              "reason",
              "from",
              "line",
              "link_text",
              "what_truncated"
            ],
            "additionalProperties": false
          }
        },
        "omitted_sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "maxLength": 2147483647
              },
              "path": {
                "type": "string",
                "maxLength": 500
              },
              "path_truncated": {
                "type": "boolean"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ai_policy",
                  "agent_instructions",
                  "contributing",
                  "pr_template",
                  "community",
                  "readme",
                  "instruction"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "file limit",
                  "scan byte limit",
                  "request limit"
                ]
              }
            },
            "required": [
              "repository",
              "path",
              "path_truncated",
              "kind",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "limits_reached": {
          "type": "array",
          "maxItems": 2147483647,
          "items": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "string",
                "maxLength": 2147483647
              },
              "not_reported": {
                "type": "integer",
                "minimum": 0
              },
              "hides_sources": {
                "type": "boolean"
              }
            },
            "required": [
              "limit",
              "not_reported",
              "hides_sources"
            ],
            "additionalProperties": false
          }
        },
        "limits_hide_sources": {
          "type": "boolean",
          "description": "A limit hid a policy candidate or reference, or omitted_sources is non-empty"
        },
        "never_inspected": {
          "type": "array",
          "maxItems": 2147483647,
          "items": {
            "type": "string",
            "maxLength": 2147483647
          }
        },
        "hints": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "possible_agent_restriction",
                  "possible_ai_restriction",
                  "possible_pr_restriction",
                  "ai_mention"
                ]
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "heading": {
                "type": "string",
                "maxLength": 120
              },
              "untrusted_excerpt": {
                "type": "string",
                "maxLength": 300
              },
              "source": {
                "type": "integer",
                "minimum": 0
              },
              "id": {
                "type": "string",
                "maxLength": 4,
                "description": "H1, H2, ... in report order"
              }
            },
            "required": [
              "kind",
              "line",
              "heading",
              "untrusted_excerpt",
              "source",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "reads": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "requests",
            "limit"
          ],
          "additionalProperties": false
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "report",
        "review_obligation",
        "sources_scanned",
        "unassessed",
        "omitted_sources",
        "limits_reached",
        "limits_hide_sources",
        "never_inspected",
        "hints",
        "reads",
        "inventory_sha256"
      ],
      "additionalProperties": false,
      "description": "Default-on, report-only policy inventory and hints; never a verdict"
    }
  }
}
