{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:1:discover",
  "title": "discover result",
  "description": "Ranked open issues of one repository, or of 2-20 repositories (discover_multi). Remote text is untrusted data.",
  "anyOf": [
    {
      "$ref": "#/$defs/discover_result"
    },
    {
      "$ref": "#/$defs/discover_unresolved"
    },
    {
      "$ref": "#/$defs/discover_multi"
    }
  ],
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 100000
        },
        "note": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "candidate",
            "unknown"
          ]
        },
        "policy_path": {
          "type": "string",
          "maxLength": 100000
        },
        "policy_commit": {
          "type": "string",
          "maxLength": 100000
        },
        "matched_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        },
        "reason": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "status",
        "policy_path",
        "policy_commit",
        "matched_labels",
        "reason"
      ],
      "additionalProperties": false,
      "description": "Source approval from the default-branch .agent-contrib.json policy; never execution authorization"
    },
    "discover_failed_entry": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "maxLength": 100000
        },
        "complete": {
          "type": "boolean",
          "const": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "issues": {
          "type": "array",
          "items": {},
          "maxItems": 0
        }
      },
      "required": [
        "requested_repository",
        "complete",
        "errors",
        "issues"
      ],
      "additionalProperties": false,
      "description": "A repository in a multi-repository run whose discovery raised"
    },
    "discover_issue": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "reference": {
          "type": "string",
          "description": "owner/repo#number in the requested repository",
          "maxLength": 100000
        },
        "issue_url": {
          "type": "string",
          "maxLength": 100000
        },
        "untrusted_title": {
          "type": "string",
          "description": "Untrusted issue title",
          "maxLength": 100000
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "description": "Excluded labels (lowercase) and \"issue is not open\"; any entry excludes the issue",
          "maxItems": 1000
        },
        "duplicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duplicate"
          },
          "maxItems": 400000,
          "description": "Open PRs referencing or overlapping the issue; any entry blocks execution"
        },
        "complete": {
          "type": "boolean"
        },
        "ranking": {
          "$ref": "#/$defs/ranking"
        },
        "signals": {
          "$ref": "#/$defs/issue_signals"
        }
      },
      "required": [
        "number",
        "reference",
        "issue_url",
        "untrusted_title",
        "approval",
        "exclusions",
        "duplicates",
        "complete",
        "ranking"
      ],
      "additionalProperties": false
    },
    "discover_multi": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/discover_result"
              },
              {
                "$ref": "#/$defs/discover_unresolved"
              },
              {
                "$ref": "#/$defs/discover_failed_entry"
              }
            ]
          },
          "minItems": 2,
          "maxItems": 20,
          "description": "One result per requested repository, in request order"
        },
        "complete": {
          "type": "boolean",
          "description": "True only when every repository is complete"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 100000,
          "description": "Each repository error prefixed with \"owner/repo: \""
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "maxLength": 100000
              },
              "reference": {
                "type": "string",
                "maxLength": 100000
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "excluded": {
                "type": "boolean"
              },
              "overlapping": {
                "type": "boolean"
              },
              "low_likelihood": {
                "type": "boolean"
              },
              "score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Signal score with --signals, else null"
              },
              "complete": {
                "type": "boolean"
              }
            },
            "required": [
              "repository",
              "reference",
              "number",
              "excluded",
              "overlapping",
              "low_likelihood",
              "score",
              "complete"
            ],
            "additionalProperties": false
          },
          "maxItems": 80000,
          "description": "Merged order of every issue across repositories"
        },
        "ordering": {
          "type": "string",
          "maxLength": 100000
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_repositories": {
              "type": "integer"
            },
            "per_repository": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "max_repositories",
            "per_repository"
          ],
          "additionalProperties": false
        },
        "warning": {
          "type": "string",
          "maxLength": 100000
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "repositories",
        "complete",
        "errors",
        "candidates",
        "ordering",
        "limits",
        "warning"
      ],
      "additionalProperties": false,
      "description": "Two to 20 repositories were requested"
    },
    "discover_result": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line",
          "maxLength": 100000
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved",
          "maxLength": 100000
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority",
          "maxLength": 100000
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "ordering": {
          "type": "string",
          "description": "Present with --signals: how issues are sorted",
          "maxLength": 100000
        },
        "schema_version": {
          "type": "string",
          "const": "0.1",
          "description": "Snapshot format version"
        },
        "repository": {
          "type": "string",
          "description": "Issue source repository that was read",
          "maxLength": 100000
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Default-branch commit of the snapshot",
          "maxLength": 40,
          "minLength": 40
        },
        "fetched_at": {
          "type": "string",
          "maxLength": 100000
        },
        "complete": {
          "type": "boolean",
          "description": "False when any read failed; missing data is never permission"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 5000
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/discover_issue"
          },
          "maxItems": 4000,
          "description": "Open issues, best candidates first"
        },
        "instructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instruction_file"
          },
          "maxItems": 60,
          "description": "Pinned repository instruction files"
        },
        "spec_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000000,
          "description": "Markdown spec/doc paths in the tree"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "pulls_scan": {
              "$ref": "#/$defs/list_scan"
            },
            "labels_scan": {
              "$ref": "#/$defs/list_scan"
            },
            "policy_state": {
              "type": "string",
              "enum": [
                "missing",
                "present",
                "unknown"
              ],
              "description": "State of .agent-contrib.json at the snapshot commit"
            },
            "proposed_target_pulls": {
              "anyOf": [
                {
                  "$ref": "#/$defs/target_pulls_scan"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Null when the target is the issue source"
            }
          },
          "required": [
            "pulls_scan",
            "labels_scan",
            "policy_state",
            "proposed_target_pulls"
          ],
          "additionalProperties": false
        },
        "issue_scan": {
          "$ref": "#/$defs/list_scan"
        },
        "limits": {
          "type": "object",
          "properties": {
            "pages_per_list": {
              "type": "integer"
            },
            "instruction_files": {
              "type": "integer"
            }
          },
          "required": [
            "pages_per_list",
            "instruction_files"
          ],
          "additionalProperties": false
        },
        "warning": {
          "type": "string",
          "maxLength": 100000
        },
        "repository_signals": {
          "type": "object",
          "properties": {
            "responsiveness": {
              "$ref": "#/$defs/responsiveness"
            }
          },
          "required": [
            "responsiveness"
          ],
          "additionalProperties": false,
          "description": "Added by --responsiveness"
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "schema_version",
        "repository",
        "commit",
        "fetched_at",
        "complete",
        "errors",
        "issues",
        "instructions",
        "spec_paths",
        "provenance",
        "issue_scan",
        "limits",
        "warning"
      ],
      "additionalProperties": false,
      "description": "One repository was resolved and read"
    },
    "discover_unresolved": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line",
          "maxLength": 100000
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved",
          "maxLength": 100000
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority",
          "maxLength": 100000
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "complete": {
          "type": "boolean",
          "const": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "issues": {
          "type": "array",
          "items": {},
          "maxItems": 0
        },
        "repository_signals": {
          "type": "object",
          "properties": {
            "responsiveness": {
              "$ref": "#/$defs/responsiveness"
            }
          },
          "required": [
            "responsiveness"
          ],
          "additionalProperties": false,
          "description": "Added by --responsiveness"
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "complete",
        "errors",
        "issues"
      ],
      "additionalProperties": false,
      "description": "The repository could not be resolved or its snapshot read"
    },
    "duplicate": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string",
          "maxLength": 100000
        },
        "reason": {
          "type": "string",
          "description": "\"Explicit reference to this issue\" or a heuristic overlap naming the shared words/IDs",
          "maxLength": 100000
        },
        "repository": {
          "type": "string",
          "description": "Repository of the PR, when it is not the issue source",
          "maxLength": 100000
        }
      },
      "required": [
        "number",
        "url",
        "reason"
      ],
      "additionalProperties": false,
      "description": "An open PR that references or overlaps the issue"
    },
    "instruction_file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 100000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "minLength": 64
        },
        "untrusted_text": {
          "type": "string",
          "maxLength": 200000,
          "description": "Untrusted repository text"
        }
      },
      "required": [
        "path",
        "sha256",
        "untrusted_text"
      ],
      "additionalProperties": false
    },
    "issue_signals": {
      "type": "object",
      "properties": {
        "code_location": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "found",
                "none",
                "unknown"
              ]
            },
            "hints": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100000
              },
              "maxItems": 20,
              "description": "Repository paths matched from the issue text"
            },
            "explanation": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "value",
            "hints",
            "explanation"
          ],
          "additionalProperties": false
        },
        "acceptance_clarity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "markers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "checklist",
                  "expected/actual sections",
                  "reproduction steps",
                  "code block"
                ]
              },
              "maxItems": 1000
            },
            "explanation": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "value",
            "markers",
            "explanation"
          ],
          "additionalProperties": false
        },
        "activity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "object",
              "properties": {
                "age_days": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "updated_days": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "comments": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "reactions": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "age_days",
                "updated_days",
                "comments",
                "reactions"
              ],
              "additionalProperties": false,
              "description": "Null when the issue payload lacks or malforms the field"
            },
            "explanation": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        "maintainer": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "maintainer",
                "other",
                "unknown"
              ]
            },
            "explanation": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "description": "code_location found (1) + acceptance clarity (0-2) + maintainer author (1)"
        }
      },
      "required": [
        "code_location",
        "acceptance_clarity",
        "activity",
        "maintainer",
        "score"
      ],
      "additionalProperties": false,
      "description": "Added by --signals; report-only heuristics, never approval"
    },
    "list_scan": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 1000
        }
      },
      "required": [
        "complete",
        "pages",
        "errors"
      ],
      "additionalProperties": false,
      "description": "Completeness of one paginated GitHub list read"
    },
    "metadata_read": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "maxLength": 100000
        },
        "observed": {
          "$ref": "#/$defs/repository_observation"
        },
        "fetched_at": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "endpoint",
        "observed",
        "fetched_at"
      ],
      "additionalProperties": false
    },
    "ranking": {
      "type": "object",
      "properties": {
        "difficulty": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "high",
                "unknown"
              ]
            },
            "explanation": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        "ambiguity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "high",
                "medium"
              ]
            },
            "explanation": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "possible",
                "unknown"
              ]
            },
            "explanation": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        "success_likelihood": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "low",
                "unknown"
              ]
            },
            "explanation": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "difficulty",
        "ambiguity",
        "dependencies",
        "success_likelihood"
      ],
      "additionalProperties": false,
      "description": "Deterministic heuristics, not predictions"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 100000
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    },
    "repository_observation": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "maxLength": 100000
        },
        "fork": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "parent": {
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "full_name"
          ],
          "additionalProperties": false,
          "description": "Immediate fork parent, when it was read"
        }
      },
      "required": [
        "full_name",
        "fork",
        "has_issues"
      ],
      "additionalProperties": false
    },
    "resolution_provenance": {
      "type": "object",
      "properties": {
        "metadata_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_read"
          },
          "maxItems": 1000
        },
        "reason": {
          "type": "string",
          "description": "How the issue tracker was chosen, or \"unresolved\"",
          "maxLength": 100000
        },
        "execution_authority": {
          "type": "string",
          "description": "Always \"none\": resolution never grants authority",
          "maxLength": 100000
        }
      },
      "required": [
        "metadata_reads",
        "reason",
        "execution_authority"
      ],
      "additionalProperties": false
    },
    "responsiveness": {
      "type": "object",
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null when discovery did not resolve the source",
          "maxLength": 100000
        },
        "endpoint": {
          "type": [
            "string",
