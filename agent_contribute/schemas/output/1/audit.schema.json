{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:1:audit",
  "title": "audit result",
  "description": "Read-only maintainer report of what an agent sees in a repository.",
  "anyOf": [
    {
      "$ref": "#/$defs/audit_report"
    },
    {
      "$ref": "#/$defs/audit_unread"
    }
  ],
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "audit_report": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line"
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved"
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority"
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "complete": {
          "type": "boolean",
          "description": "False when any read failed or a label name is malformed"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warning": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "description": "Repository whose snapshot was audited"
        },
        "commit": {
          "type": "string",
          "pattern": "[0-9a-f]{40}",
          "description": "Default-branch commit read"
        },
        "policy": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "missing",
                "present",
                "unknown"
              ]
            },
            "path": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "[0-9a-f]{40}"
            },
            "valid": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Null unless a policy file is present"
            },
            "reason": {
              "type": "string"
            },
            "approval_labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Labels the policy declares; with a list-valued declaration only"
            },
            "missing_labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Declared labels that do not exist in the repository"
            },
            "generic_approval_labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Declared labels that are generic triage labels"
            }
          },
          "required": [
            "state",
            "path",
            "commit",
            "valid",
            "reason"
          ],
          "additionalProperties": false,
          "description": "Approval policy validity at the default branch"
        },
        "instructions": {
          "type": "object",
          "properties": {
            "found": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 60,
              "description": "Instruction files agents load"
            },
            "expected": {
              "type": "object",
              "properties": {
                "contributing": {
                  "type": "string",
                  "enum": [
                    "loaded",
                    "present_unread",
                    "missing",
                    "unknown"
                  ]
                },
                "agent instructions": {
                  "type": "string",
                  "enum": [
                    "loaded",
                    "present_unread",
                    "missing",
                    "unknown"
                  ]
                },
                "pull request template": {
                  "type": "string",
                  "enum": [
                    "loaded",
                    "present_unread",
                    "missing",
                    "unknown"
                  ]
                },
                "architecture/spec index": {
                  "type": "string",
                  "enum": [
                    "loaded",
                    "present_unread",
                    "missing",
                    "unknown"
                  ]
                }
              },
              "required": [
                "contributing",
                "agent instructions",
                "pull request template",
                "architecture/spec index"
              ],
              "additionalProperties": false
            },
            "read_limit": {
              "type": "integer"
            },
            "tree_complete": {
              "type": "boolean"
            }
          },
          "required": [
            "found",
            "expected",
            "read_limit",
            "tree_complete"
          ],
          "additionalProperties": false
        },
        "labels": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "malformed": {
              "type": "integer",
              "minimum": 0
            },
            "scan": {
              "$ref": "#/$defs/list_scan"
            }
          },
          "required": [
            "count",
            "malformed",
            "scan"
          ],
          "additionalProperties": false
        },
        "issues": {
          "type": "object",
          "properties": {
            "open": {
              "type": "integer",
              "minimum": 0
            },
            "ambiguity": {
              "type": "object",
              "properties": {
                "high": {
                  "type": "integer",
                  "minimum": 1
                },
                "medium": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [],
              "additionalProperties": false,
              "description": "Open issues per ranking.ambiguity value"
            },
            "approval": {
              "type": "object",
              "properties": {
                "approved": {
                  "type": "integer",
                  "minimum": 1
                },
                "candidate": {
                  "type": "integer",
                  "minimum": 1
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [],
              "additionalProperties": false,
              "description": "Open issues per approval status"
            },
            "excluded": {
              "type": "integer",
              "minimum": 0
            },
            "overlapping": {
              "type": "integer",
              "minimum": 0
            },
            "scan": {
              "$ref": "#/$defs/list_scan"
            }
          },
          "required": [
            "open",
            "ambiguity",
            "approval",
            "excluded",
            "overlapping",
            "scan"
          ],
          "additionalProperties": false
        },
        "pull_requests": {
          "type": "object",
          "properties": {
            "open": {
              "type": "integer",
              "minimum": 0
            },
            "scan": {
              "$ref": "#/$defs/list_scan"
            },
            "overlap_density": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Share of open issues with an overlapping PR; null without issues"
            }
          },
          "required": [
            "open",
            "scan",
            "overlap_density"
          ],
          "additionalProperties": false
        },
        "fork": {
          "type": "object",
          "properties": {
            "tracker": {
              "type": "string",
              "description": "resolution_provenance.reason"
            },
            "proposed_target_pulls": {
              "anyOf": [
                {
                  "$ref": "#/$defs/target_pulls_scan"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Null unless the tracker is a fork parent"
            }
          },
          "required": [
            "tracker",
            "proposed_target_pulls"
          ],
          "additionalProperties": false
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Non-binding suggestions for maintainers"
        },
        "policy_template": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "0.1"
            },
            "agent_approved_labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "label_authority": {
              "type": "string",
              "const": "repository-label-permission"
            }
          },
          "required": [
            "schema_version",
            "agent_approved_labels",
            "label_authority"
          ],
          "additionalProperties": false,
          "description": "Example policy file; only with --print-policy, never written"
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "complete",
        "errors",
        "warning",
        "repository",
        "commit",
        "policy",
        "instructions",
        "labels",
        "issues",
        "pull_requests",
        "fork",
        "suggestions"
      ],
      "additionalProperties": false
    },
    "audit_unread": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line"
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved"
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority"
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "complete": {
          "type": "boolean",
          "const": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warning": {
          "type": "string"
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "complete",
        "errors",
        "warning"
      ],
      "additionalProperties": false,
      "description": "The repository could not be resolved or its snapshot read"
    },
    "list_scan": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "complete",
        "pages",
        "errors"
      ],
      "additionalProperties": false,
      "description": "Completeness of one paginated GitHub list read"
    },
    "metadata_read": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "observed": {
          "$ref": "#/$defs/repository_observation"
        },
        "fetched_at": {
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "observed",
        "fetched_at"
      ],
      "additionalProperties": false
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded"
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    },
    "repository_observation": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string"
        },
        "fork": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "parent": {
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string"
            }
          },
          "required": [
            "full_name"
          ],
          "additionalProperties": false,
          "description": "Immediate fork parent, when it was read"
        }
      },
      "required": [
        "full_name",
        "fork",
        "has_issues"
      ],
      "additionalProperties": false
    },
    "resolution_provenance": {
      "type": "object",
      "properties": {
        "metadata_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_read"
          }
        },
        "reason": {
          "type": "string",
          "description": "How the issue tracker was chosen, or \"unresolved\""
        },
        "execution_authority": {
          "type": "string",
          "description": "Always \"none\": resolution never grants authority"
        }
      },
      "required": [
        "metadata_reads",
        "reason",
        "execution_authority"
      ],
      "additionalProperties": false
    },
    "target_pulls_scan": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "repository",
        "endpoint",
        "complete",
        "pages",
        "errors"
      ],
      "additionalProperties": false,
      "description": "Open-PR scan of the proposed target repository when it differs from the issue source"
    }
  }
}
