{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:1:inspect",
  "title": "inspect result",
  "description": "Detailed snapshot of one issue. Remote text is untrusted data.",
  "anyOf": [
    {
      "$ref": "#/$defs/inspect_result"
    },
    {
      "$ref": "#/$defs/issue_unresolved"
    }
  ],
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "candidate",
            "unknown"
          ]
        },
        "policy_path": {
          "type": "string"
        },
        "policy_commit": {
          "type": "string"
        },
        "matched_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "policy_path",
        "policy_commit",
        "matched_labels",
        "reason"
      ],
      "additionalProperties": false,
      "description": "Source approval from the default-branch .agent-contrib.json policy; never execution authorization"
    },
    "duplicate": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "\"Explicit reference to this issue\" or a heuristic overlap naming the shared words/IDs"
        },
        "repository": {
          "type": "string",
          "description": "Repository of the PR, when it is not the issue source"
        }
      },
      "required": [
        "number",
        "url",
        "reason"
      ],
      "additionalProperties": false,
      "description": "An open PR that references or overlaps the issue"
    },
    "inspect_result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1",
          "description": "Snapshot format version"
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "default_branch": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "[0-9a-f]{40}"
            },
            "fetched_at": {
              "type": "string"
            },
            "instructions_sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            },
            "issue": {
              "type": "integer",
              "minimum": 1
            },
            "issue_url": {
              "type": "string"
            },
            "issue_updated_at": {
              "type": "string"
            },
            "issue_sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "repository",
            "default_branch",
            "commit",
            "fetched_at",
            "instructions_sha256",
            "issue",
            "issue_url",
            "issue_updated_at",
            "issue_sha256"
          ],
          "additionalProperties": false,
          "description": "Pinned snapshot; prepare copies it into the contract"
        },
        "untrusted_issue": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "title",
            "body",
            "labels"
          ],
          "additionalProperties": false,
          "description": "Untrusted issue text, sanitized"
        },
        "instructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instruction_file"
          },
          "maxItems": 60
        },
        "spec_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000000
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "duplicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duplicate"
          },
          "maxItems": 400000,
          "description": "Open PRs referencing or overlapping the issue; any entry blocks execution"
        },
        "duplicate_scan": {
          "type": "string",
          "enum": [
            "complete",
            "unknown"
          ],
          "description": "Whether the open-PR scans behind duplicates were complete"
        },
        "complete": {
          "type": "boolean",
          "description": "False when any read failed; missing data is never permission"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4000
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Excluded labels (lowercase) and \"issue is not open\"; any entry excludes the issue"
        },
        "ranking": {
          "$ref": "#/$defs/ranking"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "pulls": {
              "$ref": "#/$defs/list_scan"
            },
            "labels": {
              "$ref": "#/$defs/list_scan"
            },
            "policy_state": {
              "type": "string",
              "enum": [
                "missing",
                "present",
                "unknown"
              ],
              "description": "State of .agent-contrib.json at the snapshot commit"
            },
            "policy": {
              "$ref": "#/$defs/policy_file"
            },
            "proposed_target_pulls": {
              "$ref": "#/$defs/target_pulls_scan"
            }
          },
          "required": [
            "pulls",
            "labels",
            "policy_state",
            "policy"
          ],
          "additionalProperties": false
        },
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line"
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved"
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority"
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "reference": {
          "type": "string",
          "description": "owner/repo#number as requested"
        },
        "ownership_signals": {
          "$ref": "#/$defs/ownership_signals",
          "description": "Added by --ownership"
        },
        "ai_policy": {
          "type": "object",
          "properties": {
            "ai_policy_review": {
              "type": "string",
              "const": "required"
            },
            "coverage": {
              "type": "string",
              "enum": [
                "complete",
                "incomplete"
              ]
            },
            "excerpts_capped": {
              "type": "boolean"
            },
            "lines_partially_scanned": {
              "type": "integer",
              "minimum": 0
            },
            "excerpts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "instruction_sha256": {
                    "type": "string",
                    "pattern": "[0-9a-f]{64}"
                  },
                  "patterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "untrusted_excerpt": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "excerpt_truncated": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "path",
                  "line",
                  "instruction_sha256",
                  "patterns",
                  "untrusted_excerpt",
                  "excerpt_truncated"
                ],
                "additionalProperties": false
              },
              "maxItems": 200
            },
            "notice": {
              "type": "string"
            }
          },
          "required": [
            "ai_policy_review",
            "coverage",
            "excerpts_capped",
            "lines_partially_scanned",
            "excerpts",
            "notice"
          ],
          "additionalProperties": false,
          "description": "Added by --ai-policy: located AI-contribution statements, signals only"
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "schema_version",
        "source",
        "untrusted_issue",
        "instructions",
        "spec_paths",
        "approval",
        "duplicates",
        "duplicate_scan",
        "complete",
        "errors",
        "warnings",
        "exclusions",
        "ranking",
        "provenance",
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "reference"
      ],
      "additionalProperties": false,
      "description": "The issue was read"
    },
    "instruction_file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "untrusted_text": {
          "type": "string",
          "maxLength": 200000,
          "description": "Untrusted repository text"
        }
      },
      "required": [
        "path",
        "sha256",
        "untrusted_text"
      ],
      "additionalProperties": false
    },
    "issue_unresolved": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line"
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved"
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority"
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "reference": {
          "type": "string",
          "description": "owner/repo#number as requested"
        },
        "complete": {
          "type": "boolean",
          "const": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "reference",
        "complete",
        "errors"
      ],
      "additionalProperties": false,
      "description": "The repository or issue could not be resolved or read; nothing else is reported"
    },
    "list_scan": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "complete",
        "pages",
        "errors"
      ],
      "additionalProperties": false,
      "description": "Completeness of one paginated GitHub list read"
    },
    "metadata_read": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "observed": {
          "$ref": "#/$defs/repository_observation"
        },
        "fetched_at": {
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "observed",
        "fetched_at"
      ],
      "additionalProperties": false
    },
    "ownership_signals": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reads": {
          "type": "object",
          "properties": {
            "timeline": {
              "$ref": "#/$defs/list_scan"
            },
            "comments": {
              "$ref": "#/$defs/list_scan"
            },
            "pull_details": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "timeline",
            "comments",
            "pull_details"
          ],
          "additionalProperties": false
        },
        "cross_referenced_prs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string"
              },
              "repository_id": {
                "type": "integer"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "draft": {
                "type": "boolean"
              },
              "merged": {
                "type": "boolean"
              },
              "merged_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "closed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "exact_reference": {
                "type": "boolean",
                "description": "The PR text references this issue exactly"
              }
            },
            "required": [
              "repository",
              "repository_id",
              "number",
              "url",
              "state",
              "draft",
              "merged",
              "merged_at",
              "closed_at",
              "exact_reference"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "assignment_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "assigned",
                  "unassigned"
                ]
              },
              "assignee": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              }
            },
            "required": [
              "event",
              "assignee",
              "actor",
              "created_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 4000
        },
        "connected_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "connected",
                  "disconnected"
                ]
              },
              "actor": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              }
            },
            "required": [
              "event",
              "actor",
              "created_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 4000
        },
        "referencing_commits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commit_id": {
                "type": "string",
                "pattern": "[0-9a-f]{40}"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "commit_id",
              "url"
            ],
            "additionalProperties": false
          },
          "maxItems": 4000
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "enum": [
                  "working on it",
                  "will take it",
                  "asks to work on it",
                  "/assign command",
                  "asks for assignment"
                ]
              },
              "author": {
                "type": "string"
              },
              "author_association": {
                "type": "string",
                "enum": [
                  "COLLABORATOR",
                  "CONTRIBUTOR",
                  "FIRST_TIMER",
                  "FIRST_TIME_CONTRIBUTOR",
                  "MANNEQUIN",
                  "MEMBER",
                  "NONE",
                  "OWNER"
                ]
              },
              "age_days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "stale": {
                "type": "boolean"
              },
              "untrusted_excerpt": {
                "type": "string",
                "maxLength": 280
              }
            },
            "required": [
              "pattern",
              "author",
              "author_association",
              "age_days",
              "stale",
              "untrusted_excerpt"
            ],
            "additionalProperties": false
          },
          "maxItems": 4000,
          "description": "Comments matching claim phrases; text cannot prove ownership"
        },
        "resolution_signals": {
          "type": "object",
          "properties": {
            "possibly_already_fixed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "repository_id": {
                    "type": "integer"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "url": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "open",
                      "closed"
                    ]
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "merged": {
                    "type": "boolean"
                  },
                  "merged_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "closed_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exact_reference": {
                    "type": "boolean",
                    "description": "The PR text references this issue exactly"
                  }
                },
                "required": [
                  "repository",
                  "repository_id",
                  "number",
                  "url",
                  "state",
                  "draft",
                  "merged",
                  "merged_at",
                  "closed_at",
                  "exact_reference"
                ],
                "additionalProperties": false
              },
              "maxItems": 50,
              "description": "Merged PRs referencing the issue exactly"
            },
            "rejected_approaches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "repository_id": {
                    "type": "integer"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "url": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "open",
                      "closed"
                    ]
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "merged": {
                    "type": "boolean"
                  },
                  "merged_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "closed_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exact_reference": {
                    "type": "boolean",
                    "description": "The PR text references this issue exactly"
                  }
                },
                "required": [
                  "repository",
                  "repository_id",
                  "number",
                  "url",
                  "state",
                  "draft",
                  "merged",
                  "merged_at",
                  "closed_at",
                  "exact_reference"
                ],
                "additionalProperties": false
              },
              "maxItems": 50,
              "description": "Closed unmerged PRs referencing the issue exactly"
            },
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "unknown"
              ]
            }
          },
          "required": [
            "possibly_already_fixed",
            "rejected_approaches",
            "status"
          ],
          "additionalProperties": false
        },
        "blocking_if_adopted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "description": "Preview of what would block if these signals became gates; nothing blocks now"
        },
        "notice": {
          "type": "string"
        }
      },
      "required": [
        "complete",
        "errors",
        "reads",
        "cross_referenced_prs",
        "assignment_history",
        "connected_events",
        "referencing_commits",
        "claims",
        "resolution_signals",
        "blocking_if_adopted",
        "notice"
      ],
      "additionalProperties": false,
      "description": "Report-only ownership and resolution signals; never change gates"
    },
    "policy_file": {
      "type": [
        "object",
        "null"
      ],
      "properties": {},
      "required": [],
      "additionalProperties": true,
      "description": "The parsed .agent-contrib.json exactly as read; untrusted and possibly invalid"
    },
    "ranking": {
      "type": "object",
      "properties": {
        "difficulty": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "high",
                "unknown"
              ]
            },
            "explanation": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        "ambiguity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "high",
                "medium"
              ]
            },
            "explanation": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "possible",
                "unknown"
              ]
            },
            "explanation": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        "success_likelihood": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "low",
                "unknown"
              ]
            },
            "explanation": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "explanation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "difficulty",
        "ambiguity",
        "dependencies",
        "success_likelihood"
      ],
      "additionalProperties": false,
      "description": "Deterministic heuristics, not predictions"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded"
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    },
    "repository_observation": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string"
        },
        "fork": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "parent": {
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string"
            }
          },
          "required": [
            "full_name"
          ],
          "additionalProperties": false,
          "description": "Immediate fork parent, when it was read"
        }
      },
      "required": [
        "full_name",
        "fork",
        "has_issues"
      ],
      "additionalProperties": false
    },
    "resolution_provenance": {
      "type": "object",
      "properties": {
        "metadata_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_read"
          }
        },
        "reason": {
          "type": "string",
          "description": "How the issue tracker was chosen, or \"unresolved\""
        },
        "execution_authority": {
          "type": "string",
          "description": "Always \"none\": resolution never grants authority"
        }
      },
      "required": [
        "metadata_reads",
        "reason",
        "execution_authority"
      ],
      "additionalProperties": false
    },
    "target_pulls_scan": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "repository",
        "endpoint",
        "complete",
        "pages",
        "errors"
      ],
      "additionalProperties": false,
      "description": "Open-PR scan of the proposed target repository when it differs from the issue source"
    }
  }
}
